[Unit]
Description=Console server domain socket listener
# DefaultDependencies=no + defer past bmc-boot-complete.service, same as
# the paired obmc-console-VSERn.socket per-channel files.
DefaultDependencies=no
Requires=sysinit.target
After=sysinit.target bmc-boot-complete.service
Conflicts=shutdown.target
Before=obmc-console@%i.service shutdown.target

[Socket]
ListenStream=@obmc-console.%i
Accept=no
Service=obmc-console@%i.service

[Install]
# Handled by bitbake recipe
